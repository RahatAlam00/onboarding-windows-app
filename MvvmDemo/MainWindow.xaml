<Window x:Class="MvvmDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MvvmDemo.ViewModels"
        Title="MVVM Demo"
        Height="280"
        Width="420">

	<Window.DataContext>
		<vm:MainViewModel/>
	</Window.DataContext>

	<Grid Margin="24">

		<StackPanel>
			<TextBlock
                Text="MVVM Data Binding Demo"
                FontSize="22"
                FontWeight="Bold"
                Margin="0,0,0,20"/>

			<TextBlock
                Text="Name"/>

			<TextBox
                Text="{Binding Name,
                               Mode=TwoWay,
                               UpdateSourceTrigger=PropertyChanged}"
                Margin="0,5,0,20"/>

			<TextBlock
                Text="{Binding Greeting}"
                FontSize="18"
                FontWeight="SemiBold"/>
		</StackPanel>

	</Grid>
</Window>