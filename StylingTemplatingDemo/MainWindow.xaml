<Window x:Class="StylingTemplatingDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Styling and Templating Demo"
        Height="520"
        Width="650">

    <Window.Resources>

        <Style x:Key="StyledButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="SteelBlue" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontSize"
                    Value="20" />
            <Setter Property="Padding"
                    Value="12" />
            <Setter Property="Margin"
                    Value="0,8,0,8" />
            <Setter Property="Width"
                    Value="300" />
            <Setter Property="Height"
                    Value="50" />
        </Style>

        <Style x:Key="TemplatedButton"
               TargetType="Button"
               BasedOn="{StaticResource StyledButton}">

            <Setter Property="Background"
                    Value="DarkSlateBlue" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Black"
                                BorderThickness="2"
                                CornerRadius="25">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="Orange" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <StackPanel Margin="40"
                VerticalAlignment="Center">

        <TextBlock Text="Styling &amp; Templating"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25" />

        <TextBlock Text="Default Button"
                   FontWeight="Bold" />

        <Button Content="Default Button"
                Width="220"
                Height="50"
                Margin="0,8,0,18" />

        <TextBlock Text="Styled Button"
                   FontWeight="Bold" />

        <Button Content="Styled Button"
                Style="{StaticResource StyledButton}" />

        <TextBlock Text="Custom Template"
                   FontWeight="Bold"
                   Margin="0,10,0,0" />

        <Button Content="Rounded Template Button"
                Style="{StaticResource TemplatedButton}" />

    </StackPanel>
</Window>