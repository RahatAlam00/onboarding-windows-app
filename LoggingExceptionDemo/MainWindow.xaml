<Window x:Class="LoggingExceptionDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logging &amp; Exception Handling Demo"
        Height="320"
        Width="520">

    <StackPanel Margin="30"
                VerticalAlignment="Center">

        <TextBlock Text="Logging &amp; Exception Handling"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <Button Content="Load Missing File"
                Width="180"
                Height="45"
                HorizontalAlignment="Left"
                Click="LoadFileButton_Click" />

        <TextBlock x:Name="StatusText"
                   Text="Click the button to test error handling."
                   FontSize="16"
                   TextWrapping="Wrap"
                   Margin="0,20,0,0" />

    </StackPanel>
</Window>