<Window x:Class="TestingDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discount Calculator"
        Height="360"
        Width="520">

    <StackPanel Margin="30"
                VerticalAlignment="Center">

        <TextBlock Text="Discount Calculator"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <TextBlock Text="Original price" />
        <TextBox x:Name="OriginalPriceTextBox"
                 Margin="0,5,0,15" />

        <TextBlock Text="Discount percentage" />
        <TextBox x:Name="DiscountPercentageTextBox"
                 Margin="0,5,0,15" />

        <Button Content="Calculate"
                Width="120"
                Height="40"
                HorizontalAlignment="Left"
                Click="CalculateButton_Click" />

        <TextBlock x:Name="ResultText"
                   Text="Enter values and click Calculate."
                   FontSize="16"
                   Margin="0,20,0,0"
                   TextWrapping="Wrap" />

    </StackPanel>
</Window>
