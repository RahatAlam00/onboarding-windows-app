<Window x:Class="XamlBasics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XAML Basics"
        Height="350"
        Width="500">

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock
            Text="Employee Login"
            FontSize="24"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,0,0,20"/>

		<StackPanel
            Grid.Row="1">

			<Label Content="Username"/>

			<TextBox
                Margin="0,0,0,10"/>

			<Label Content="Password"/>

			<PasswordBox
                Margin="0,0,0,20"/>

			<Button
                Content="Login"
                Width="120"
                HorizontalAlignment="Center"
                Background="SteelBlue"
                Foreground="White"/>

		</StackPanel>

	</Grid>

</Window>